{
  "expo": {
    "name": "CloudVaulter",
    "slug": "cloudvaulter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.cloudvaulter.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CloudVaulter needs camera access to capture photos for upload.",
        "NSPhotoLibraryUsageDescription": "CloudVaulter needs photo library access to upload images.",
        "NSPhotoLibraryAddUsageDescription": "CloudVaulter needs permission to save files to your photo library.",
        "NSDocumentPickerUsageDescription": "CloudVaulter needs access to your documents for uploading files."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B00"
      },
      "package": "space.cloudvaulter.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CloudVaulter needs access to your photos for uploading.",
          "cameraPermission": "CloudVaulter needs camera access."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.cloudvaulter.space",
      "eas": {
        "projectId": "cloudvaulter-mobile"
      }
    }
  }
}
